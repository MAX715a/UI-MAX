function NyxUI:AddButton(parent, text, callback)
    local btn = create("TextButton", {
        Name = "Button",
        Text = text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = self.Theme.Text,
        BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 38),
        AutoButtonColor = false,
        TextScaled = false,
        ZIndex = 12,
        Parent = parent,
    })
    corner(btn, 8)

    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = self.Theme.AccentSoft
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = self.Theme.SurfaceAlt
    end)
    btn.MouseButton1Click:Connect(function()
        btn.BackgroundColor3 = self.Theme.Accent
        task.delay(0.1, function()
            if btn and btn.Parent then
                btn.BackgroundColor3 = self.Theme.SurfaceAlt
            end
        end)
        if callback then
            local ok, err = pcall(callback)
            if not ok then
                self:Notify("خطأ", tostring(err), NotificationType.Error, 4)
            end
        end
    end)

    return btn
end

function NyxUI:AddToggle(parent, text, default, callback)
    local row = create("Frame", {
        Name = "ToggleRow",
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
        ZIndex = 12,
        Parent = parent,
    })

    create("TextLabel", {
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = self.Theme.Text,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextScaled = false,
        Size = UDim2.new(1, -52, 1, 0),
        ZIndex = 12,
        Parent = row,
    })

    local switch = create("Frame", {
        Name = "Switch",
        Size = UDim2.fromOffset(38, 20),
        Position = UDim2.new(1, -38, 0.5, -10),
        BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        ZIndex = 12,
        Parent = row,
    })
    corner(switch, 10)

    local knob = create("Frame", {
        Name = "Knob",
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = self.Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 13,
        Parent = switch,
    })
    corner(knob, 8)

    local state = default or false
    local function update()
        quickTween(knob, { Position = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2) }, 0.12)
        switch.BackgroundColor3 = state and self.Theme.Accent or self.Theme.SurfaceAlt
    end
    update()

    local btn = create("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 14,
        Parent = switch,
    })
    btn.MouseButton1Click:Connect(function()
        state = not state
        update()
        if callback then
            local ok, err = pcall(callback, state)
            if not ok then
                self:Notify("خطأ", tostring(err), NotificationType.Error, 4)
            end
        end
        self._config[text] = state
    end)

    self.Widgets[text] = {
        Type = "Toggle",
        Get = function() return state end,
        Set = function(v) state = v; update() end,
    }

    return {
        Set = function(_, v)
            state = v
            update()
            if callback then pcall(callback, state) end
        end,
        Get = function() return state end,
    }
end

function NyxUI:AddSlider(parent, text, min, max, default, callback)
    min = tonumber(min) or 0
    max = tonumber(max) or 100
    if max <= min then max = min + 1 end

    local row = create("Frame", {
        Name = "SliderRow", Size = UDim2.new(1, 0, 0, 54),
        BackgroundTransparency = 1, ZIndex = 12, Parent = parent,
    })
    create("TextLabel", {
        Text = text, Font = Enum.Font.GothamMedium, TextSize = 12,
        TextColor3 = self.Theme.Text, BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
        TextScaled = false, Size = UDim2.new(1, -64, 0, 20), ZIndex = 12, Parent = row,
    })
    local valueLbl = create("TextLabel", {
        Text = tostring(default or min), Font = Enum.Font.GothamBold, TextSize = 12,
        TextColor3 = self.Theme.Accent, BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Center,
        TextScaled = false, Size = UDim2.new(0, 60, 0, 20),
        Position = UDim2.new(1, -60, 0, 0), ZIndex = 12, Parent = row,
    })
    local bar = create("TextButton", {
        Name = "SliderTrack", Text = "", Size = UDim2.new(1, 0, 0, 10),
        Position = UDim2.new(0, 0, 0, 34), BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0, AutoButtonColor = false, Active = true,
        Selectable = false, ZIndex = 12, Parent = row,
    })
    corner(bar, 5)
    local fill = create("Frame", {
        Name = "Fill", Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = self.Theme.Accent, BorderSizePixel = 0,
        Active = true, ZIndex = 13, Parent = bar,
    })
    corner(fill, 5)
    local knob = create("Frame", {
        Name = "Knob", AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(16, 16), Position = UDim2.new(1, 0, 0.5, 0),
        BackgroundColor3 = self.Theme.Text, BorderSizePixel = 0,
        Active = true, ZIndex = 14, Parent = fill,
    })
    corner(knob, 8)
    stroke(knob, self.Theme.Accent, 2, 0)

    local value = math.clamp(tonumber(default) or min, min, max)
    local dragging, activeTouch = false, nil
    local function setValue(v, fire)
        value = math.clamp(v, min, max)
        local alpha = (value - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        valueLbl.Text = tostring(math.floor(value + 0.5))
        if fire and callback then
            local ok, err = pcall(callback, value)
            if not ok then self:Notify("Error", tostring(err), NotificationType.Error, 4) end
        end
    end
    local function updateFromX(x, fire)
        if not bar.Parent then return end
        local width = bar.AbsoluteSize.X
        if width <= 0 then return end
        local alpha = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
        setValue(min + (max - min) * alpha, fire)
        self._config[text] = value
    end
    local function beginDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateFromX(input.Position.X, true)
        elseif input.UserInputType == Enum.UserInputType.Touch then
            dragging, activeTouch = true, input
            updateFromX(input.Position.X, true)
        end
    end
    bar.InputBegan:Connect(beginDrag)
    fill.InputBegan:Connect(beginDrag)
    knob.InputBegan:Connect(beginDrag)
    local endConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        elseif input == activeTouch then
            dragging, activeTouch = false, nil
        end
    end)
    local moveConn = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                updateFromX(input.Position.X, true)
            else
                dragging = false
            end
        end
    end)
    local touchMoveConn = UserInputService.TouchMoved:Connect(function(input)
        if dragging and activeTouch then
            updateFromX(input.Position.X, true)
        end
    end)
    table.insert(self.Connections, endConn)
    table.insert(self.Connections, moveConn)
    table.insert(self.Connections, touchMoveConn)
    setValue(value, false)

    self.Widgets[text] = {
        Type = "Slider",
        Get = function() return value end,
        Set = function(v) setValue(tonumber(v) or min, true) end,
    }
    return {
        Set = function(_, v) setValue(tonumber(v) or min, true) end,
        Get = function() return value end,
    }
end

