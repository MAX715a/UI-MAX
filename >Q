function NyxUI:_applyTheme()
    local t = self.Theme
    self.Window.BackgroundColor3 = t.Background
    self.TabsBar.BackgroundColor3 = t.Surface
    self.TitleLabel.TextColor3 = t.Text
    self.SubtitleLabel.TextColor3 = t.TextDim
    self.CloseButton.BackgroundColor3 = t.SurfaceAlt
    self.CloseButton.TextColor3 = t.TextDim
    self.MinButton.BackgroundColor3 = t.SurfaceAlt
    self.MinButton.TextColor3 = t.TextDim
    self.TabIndicator.BackgroundColor3 = t.Accent
    self.Scroll.ScrollBarImageColor3 = t.Accent
    self.Footer.TextColor3 = t.TextDim

    for _, d in ipairs(self.Window:GetDescendants()) do
        if d:IsA("UIStroke") then
            d.Color = t.Stroke
        end
    end

    for _, tab in ipairs(self.Tabs) do
        if tab.Button then
            local active = (self.ActiveTab == tab)
            tab.Button.BackgroundColor3 = active and t.SurfaceAlt or t.Surface
            tab.Button.TextColor3 = active and t.Text or t.TextDim
        end
    end

    for _, notif in ipairs(self._notifications) do
        if notif.Frame and notif.Frame.Parent then
            notif.Frame.BackgroundColor3 = t.Surface
        end
    end
end

function NyxUI:AddTab(name)
    local tab = { Name = name, Built = false }

    local btn = create("TextButton", {
        Name = "Tab_" .. name,
        Text = name,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = self.Theme.TextDim,
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(72, 24),
        AutoButtonColor = false,
        Parent = self.TabsBar,
    })
    corner(btn, 6)

    btn.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            btn.BackgroundColor3 = self.Theme.SurfaceAlt
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            btn.BackgroundColor3 = self.Theme.Surface
        end
    end)
    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    tab.Button = btn
    table.insert(self.Tabs, tab)

    if not self.ActiveTab then
        self:SelectTab(tab)
    end

    return tab
end

function NyxUI:SelectTab(tab)
    if self.ActiveTab == tab then return end
    self.ActiveTab = tab

    for _, t in ipairs(self.Tabs) do
        local active = (t == tab)
        t.Button.BackgroundColor3 = active and self.Theme.SurfaceAlt or self.Theme.Surface
        t.Button.TextColor3 = active and self.Theme.Text or self.Theme.TextDim
    end

    local btn = tab.Button
    local targetPos = UDim2.new(
        0, btn.AbsolutePosition.X - self.TabsBar.AbsolutePosition.X,
        1, -4
    )
    local targetSize = UDim2.new(0, btn.AbsoluteSize.X, 0, 2)
    quickTween(self.TabIndicator, { Position = targetPos, Size = targetSize }, 0.14)

    for _, child in ipairs(self.Scroll:GetChildren()) do
        if child:IsA("Frame") and child.Name == "TabContent" then
            child.Visible = false
        end
    end

    if not tab.Built then
        local content = create("Frame", {
            Name = "TabContent",
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.Y,
            Parent = self.Scroll,
        })
        list(content, Enum.FillDirection.Vertical, 8)
        tab.Content = content
        tab.Built = true
    end
    tab.Content.Visible = true
end

function NyxUI:AddSection(tab, title)
    local section = create("Frame", {
        Name = "Section",
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = tab.Content,
    })
    corner(section, 8)
    stroke(section, self.Theme.Stroke, 1, 0.3)
    list(section, Enum.FillDirection.Vertical, 6)
    pad(section, 8, 8, 8, 8)

    if title then
        local lbl = create("TextLabel", {
            Name = "Title",
            Text = title,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextColor3 = self.Theme.Text,
            BackgroundTransparency = 1,
            TextXAlignment = Enum.TextXAlignment.Left,
            Size = UDim2.new(1, 0, 0, 16),
            Parent = section,
        })
        lbl.LayoutOrder = -1
    end

    return section
end

function NyxUI:AddButton(parent, text, callback)
    local btn = create("TextButton", {
        Name = "Button",
        Text = text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = self.Theme.Text,
        BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 28),
        AutoButtonColor = false,
        Parent = parent,
    })
    corner(btn, 6)

    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = self.Theme.AccentSoft
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = self.Theme.SurfaceAlt
    end)
    btn.MouseButton1Click:Connect(function()
        btn.BackgroundColor3 = self.Theme.Accent
        task.delay(0.1, function()
            if btn and btn.Parent then
                btn.BackgroundColor3 = self.Theme.SurfaceAlt
            end
        end)
        if callback then
            local ok, err = pcall(callback)
            if not ok then
                self:Notify("خطأ", tostring(err), NotificationType.Error, 4)
            end
        end
    end)

    return btn
end

function NyxUI:AddToggle(parent, text, default, callback)
    local row = create("Frame", {
        Name = "ToggleRow",
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        Parent = parent,
    })

    create("TextLabel", {
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = self.Theme.Text,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, -50, 1, 0),
        Parent = row,
    })

    local switch = create("Frame", {
        Name = "Switch",
        Size = UDim2.fromOffset(36, 18),
        Position = UDim2.new(1, -36, 0.5, -9),
        BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        Parent = row,
    })
    corner(switch, 9)

    local knob = create("Frame", {
        Name = "Knob",
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = self.Theme.Text,
        BorderSizePixel = 0,
        Parent = switch,
    })
    corner(knob, 7)

    local state = default or false
    local function update()
        quickTween(knob, { Position = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2) }, 0.12)
        switch.BackgroundColor3 = state and self.Theme.Accent or self.Theme.SurfaceAlt
    end
    update()

    local btn = create("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Parent = switch,
    })
    btn.MouseButton1Click:Connect(function()
        state = not state
        update()
        if callback then
            local ok, err = pcall(callback, state)
            if not ok then
                self:Notify("خطأ", tostring(err), NotificationType.Error, 4)
            end
        end
        self._config[text] = state
    end)

    self.Widgets[text] = {
        Type = "Toggle",
        Get = function() return state end,
        Set = function(v) state = v; update() end,
    }

    return {
        Set = function(_, v)
            state = v
            update()
            if callback then pcall(callback, state) end
        end,
        Get = function() return state end,
    }
end

function NyxUI:AddSlider(parent, text, min, max, default, callback)
    local row = create("Frame", {
        Name = "SliderRow",
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundTransparency = 1,
        Parent = parent,
    })

    create("TextLabel", {
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = self.Theme.Text,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, -50, 0, 16),
        Parent = row,
    })

    local valueLbl = create("TextLabel", {
        Text = tostring(default or min),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = self.Theme.Accent,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Right,
        Size = UDim2.new(0, 50, 0, 16),
        Position = UDim2.new(1, -50, 0, 0),
        Parent = row,
    })

    local bar = create("Frame", {
        Name = "Bar",
        Size = UDim2.new(1, 0, 0, 5),
        Position = UDim2.new(0, 0, 0, 26),
        BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        Parent = row,
    })
    corner(bar, 2)

    local fill = create("Frame", {
        Name = "Fill",
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = self.Theme.Accent,
        BorderSizePixel = 0,
        Parent = bar,
    })
    corner(fill, 2)

    local knob = create("Frame", {
        Name = "Knob",
        Size = UDim2.fromOffset(12, 12),
        Position = UDim2.new(0, -6, 0.5, -6),
        BackgroundColor3 = self.Theme.Text,
        BorderSizePixel = 0,
        Parent = fill,
    })
    corner(knob, 6)

    local value = default or min
    local function setValue(v, fire)
        value = math.clamp(v, min, max)
        local alpha = (value - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        valueLbl.Text = tostring(math.floor(value))
        if fire and callback then
            local ok, err = pcall(callback, value)
            if not ok then
                self:Notify("خطأ", tostring(err), NotificationType.Error, 4)
            end
        end
    end
    setValue(value, false)

    local dragging = false
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    local endConn = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    local moveConn = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
            setValue(min + (max - min) * math.clamp(rel, 0, 1), true)
            self._config[text] = value
        end
    end)
    table.insert(self.Connections, endConn)
    table.insert(self.Connections, moveConn)

    self.Widgets[text] = {
        Type = "Slider",
        Get = function() return value end,
        Set = function(v) setValue(v, true) end,
    }

    return {
        Set = function(_, v) setValue(v, true) end,
        Get = function() return value end,
    }
end

