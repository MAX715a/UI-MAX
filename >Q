function NyxUI:SetTheme(themeName)
    if not Themes[themeName] then return end
    self.ThemeName = themeName
    self.Theme = Themes[themeName]
    self:_applyTheme()
end

function NyxUI:_saveConfig()
    if not writefile or not isfolder then return end
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(self._config or {})
    end)
    if not ok then return end
    if not isfolder("MAX_UI") then
        pcall(makefolder, "MAX_UI")
    end
    pcall(writefile, "MAX_UI/" .. self.SaveName .. ".json", encoded)
end

function NyxUI:_loadConfig()
    if not readfile or not isfile then return end
    local path = "MAX_UI/" .. self.SaveName .. ".json"
    if isfile(path) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(path))
        end)
        if ok and type(data) == "table" then
            self._config = data
        end
    end
end

function NyxUI:Save()
    self:_saveConfig()
    self:NotifySuccess("MAX UI", "تم حفظ الإعدادات", 2)
end

function NyxUI:Load()
    self:_loadConfig()
    for name, widget in pairs(self.Widgets) do
        local stored = self._config[name]
        if stored ~= nil then
            if widget.Type == "Toggle" and type(stored) == "boolean" then
                widget.Set(stored)
            elseif widget.Type == "Slider" and type(stored) == "number" then
                widget.Set(stored)
            elseif widget.Type == "Dropdown" then
                widget.Set(stored)
            elseif widget.Type == "Color" and type(stored) == "table" then
                widget.Set(Color3.new(stored[1], stored[2], stored[3]))
            end
        end
    end
    self:NotifySuccess("MAX UI", "تم تحميل الإعدادات", 2)
end

function NyxUI:Destroy()
    for _, conn in ipairs(self.Connections) do
        if conn and conn.Disconnect then
            pcall(function() conn:Disconnect() end)
        end
    end
    self.Connections = {}
    if self.Gui and self.Gui.Parent then
        self.Gui:Destroy()
    end
end

