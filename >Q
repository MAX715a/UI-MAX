        Position = UDim2.new(0.5, 8, 1, 3),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 50,
        Parent = row,
    })
    corner(listFrame, 5)
    stroke(listFrame, self.Theme.Stroke, 1, 0.2)
    list(listFrame, Enum.FillDirection.Vertical, 2)
    pad(listFrame, 4, 4, 4, 4)

    local current = default
    local open = false

    for _, opt in ipairs(options) do
        local optBtn = create("TextButton", {
            Text = tostring(opt),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = self.Theme.Text,
            BackgroundColor3 = self.Theme.SurfaceAlt,
            BackgroundTransparency = 0.3,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 22),
            AutoButtonColor = false,
            Parent = listFrame,
        })
        corner(optBtn, 4)
        optBtn.MouseButton1Click:Connect(function()
            current = opt
            btn.Text = tostring(opt)
            open = false
            listFrame.Visible = false
            listFrame.Size = UDim2.new(0.5, -8, 0, 0)
            if callback then
                local ok, err = pcall(callback, opt)
                if not ok then
                    self:Notify("خطأ", tostring(err), NotificationType.Error, 4)
                end
            end
            self._config[text] = opt
        end)
    end

    local function refreshListSize()
        listFrame.Size = UDim2.new(0.5, -8, 0, #options * 24 + 8)
    end

    btn.MouseButton1Click:Connect(function()
        open = not open
        listFrame.Visible = open
        if open then refreshListSize() end
    end)

    self.Widgets[text] = {
        Type = "Dropdown",
        Get = function() return current end,
        Set = function(v)
            for _, opt in ipairs(options) do
                if tostring(opt) == tostring(v) then
                    current = opt
                    btn.Text = tostring(opt)
                    if callback then pcall(callback, opt) end
                    return
                end
            end
        end,
    }

    return {
        Set = function(_, v)
            for _, opt in ipairs(options) do
                if tostring(opt) == tostring(v) then
                    current = opt
                    btn.Text = tostring(opt)
                    if callback then pcall(callback, opt) end
                    return
                end
            end
        end,
        Get = function() return current end,
    }
end

