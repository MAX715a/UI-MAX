function NyxUI:_reflowNotifications()
    local baseY = 16
    local spacing = 8
    local index = 0
    for i = #self._notifications, 1, -1 do
        local notif = self._notifications[i]
        if notif.Frame and notif.Frame.Parent then
            local targetY = baseY + index * (notif.Height + spacing)
            quickTween(notif.Frame, {
                Position = UDim2.new(1, -(IS_MOBILE and 232 or 290), 0, targetY),
            }, 0.14)
            index = index + 1
        end
    end
end

function NyxUI:Notify(title, message, notifType, duration)
    notifType = notifType or NotificationType.Info
    duration = duration or 3

    local color = self.Theme.Info
    if notifType == NotificationType.Success then color = self.Theme.Success
    elseif notifType == NotificationType.Error then color = self.Theme.Error
    elseif notifType == NotificationType.Warning then color = self.Theme.Warning
    elseif notifType == NotificationType.Info then color = self.Theme.Info
    end

    local width = IS_MOBILE and 220 or 270

    local notif = create("Frame", {
        Name = "Notification",
        Size = UDim2.fromOffset(width, 0),
        Position = UDim2.new(1, 20, 0, 16),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 100,
        Parent = self.Gui,
    })
    corner(notif, 8)
    stroke(notif, color, 1, 0.25)
    pad(notif, 10, 10, 12, 12)
    list(notif, Enum.FillDirection.Vertical, 5)

    local header = create("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        ZIndex = 101,
        Parent = notif,
    })

    local dot = create("Frame", {
        Name = "Dot",
        Size = UDim2.fromOffset(8, 8),
        Position = UDim2.new(0, 0, 0.5, -4),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        ZIndex = 102,
        Parent = header,
    })
    corner(dot, 4)

    create("TextLabel", {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = self.Theme.Text,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextScaled = false,
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -14, 1, 0),
        ZIndex = 102,
        Parent = header,
    })

    create("TextLabel", {
        Text = message,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = self.Theme.TextDim,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        TextScaled = false,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 102,
        Parent = notif,
    })

    create("TextLabel", {
        Text = "حقوق " .. RIGHTS,
        Font = Enum.Font.Gotham,
        TextSize = 9,
        TextColor3 = self.Theme.TextDim,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextScaled = false,
        Size = UDim2.new(1, 0, 0, 10),
        ZIndex = 102,
        Parent = notif,
    })

    local progressBg = create("Frame", {
        Name = "ProgressBg",
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        ZIndex = 101,
        Parent = notif,
    })
    corner(progressBg, 2)

    local progressFill = create("Frame", {
        Name = "ProgressFill",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        ZIndex = 102,
        Parent = progressBg,
    })
    corner(progressFill, 2)

    notif.Size = UDim2.fromOffset(width, 0)
    local absHeight = notif.AbsoluteSize.Y
    if absHeight <= 0 then
        absHeight = 86
    end

    local entry = {
        Frame = notif,
        Height = absHeight,
        Color = color,
    }
    self._notificationOrder = self._notificationOrder + 1
    table.insert(self._notifications, entry)

    self:_reflowNotifications()

    quickTween(progressFill, { Size = UDim2.new(0, 0, 1, 0) }, duration)

    task.delay(duration, function()
        if notif and notif.Parent then
            quickTween(notif, { Position = UDim2.new(1, 20, 0, notif.Position.Y.Offset) }, 0.12)
            task.delay(0.14, function()
                if notif and notif.Parent then
                    notif:Destroy()
                end
                for i = #self._notifications, 1, -1 do
                    if self._notifications[i].Frame == notif then
                        table.remove(self._notifications, i)
                    end
                end
                self:_reflowNotifications()
            end)
        end
    end)
end

