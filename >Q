function NyxUI.new(opts)
    opts = opts or {}
    local self = setmetatable({}, NyxUI)

    self.ThemeName = opts.Theme or "Midnight"
    self.Theme = Themes[self.ThemeName] or Themes.Midnight
    self.Title = opts.Title or "MAX UI"
    self.Subtitle = opts.Subtitle or ("AURORA EDITION  •  " .. VERSION .. "  •  " .. RIGHTS)
    self.SaveName = opts.SaveName or "MAX_UI_Config"
    self.StarsEnabled = opts.Stars ~= false

    if IS_MOBILE then
        self.Width = opts.Width or 340
        self.Height = opts.Height or 450
    else
        self.Width = opts.Width or 720
        self.Height = opts.Height or 520
    end

    self.Tabs = {}
    self.ActiveTab = nil
    self.Connections = {}
    self.Widgets = {}
    self._config = {}
    self._notifications = {}
    self._notificationOrder = 0
    self._stars = {}
    self._starConn = nil

    self:_loadConfig()
    self:_buildGui()
    self:_buildStars()
    self:_buildWindow()
    self:_buildTabsBar()
    self:_buildContainer()
    self:_applyTheme()
    self:_startStars()

    _G.MAXUI = self
    _G.NyxUI = self -- backward-compatible alias
    _G.NyxUI_RIGHTS = RIGHTS
    _G.NyxUI_VERSION = VERSION
    _G.NyxUI_MOBILE = IS_MOBILE

    return self
end

function NyxUI:_buildGui()
    if self.Gui and self.Gui.Parent then
        self.Gui:Destroy()
    end
    local parent = (type(gethui) == "function" and gethui()) or LocalPlayer:WaitForChild("PlayerGui")
    self.Gui = create("ScreenGui", {
        Name = "MAX_UI_Aurora",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
        Parent = parent,
    })
end

function NyxUI:_buildStars()
    self.StarLayer = create("Frame", {
        Name = "StarLayer",
        Size = UDim2.fromOffset(self.Width, self.Height),
        Position = UDim2.new(0.5, -self.Width / 2, 0.5, -self.Height / 2),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 1,
        Parent = self.Gui,
    })
    corner(self.StarLayer, 10)

    if not self.StarsEnabled then return end

    local count = IS_MOBILE and 18 or 32
    for i = 1, count do
        local size = math.random(2, 4)
        local star = create("Frame", {
            Name = "Star" .. i,
            Size = UDim2.fromOffset(size, size),
            Position = UDim2.new(math.random(), 0, math.random(), 0),
            BackgroundColor3 = self.Theme.Star,
            BackgroundTransparency = math.random(40, 80) / 100,
            BorderSizePixel = 0,
            ZIndex = 2,
            Parent = self.StarLayer,
        })
        corner(star, size / 2)
        table.insert(self._stars, {
            Frame = star,
            SpeedX = (math.random() - 0.5) * 0.02,
            SpeedY = (math.random() - 0.5) * 0.02,
            TwinkleSpeed = math.random(10, 30) / 10,
            TwinklePhase = math.random() * math.pi * 2,
        })
    end
end

function NyxUI:_startStars()
    if not self.StarsEnabled then return end
    local elapsed = 0
    self._starConn = RunService.Heartbeat:Connect(function(dt)
        elapsed = elapsed + dt
        for _, star in ipairs(self._stars) do
            local frame = star.Frame
            if frame and frame.Parent then
                local pos = frame.Position
                local newX = pos.X.Scale + star.SpeedX * dt
                local newY = pos.Y.Scale + star.SpeedY * dt
                if newX < 0 then newX = 1 elseif newX > 1 then newX = 0 end
                if newY < 0 then newY = 1 elseif newY > 1 then newY = 0 end
                frame.Position = UDim2.new(newX, 0, newY, 0)
                local twinkle = (math.sin(elapsed * star.TwinkleSpeed + star.TwinklePhase) + 1) / 2
                frame.BackgroundTransparency = 0.4 + twinkle * 0.5
            end
        end
    end)
    table.insert(self.Connections, self._starConn)
end

