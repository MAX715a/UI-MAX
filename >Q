function NyxUI:AddColorPicker(parent, text, default, callback)
    local row = create("Frame", {
        Name = "ColorRow",
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        Parent = parent,
    })

    create("TextLabel", {
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = self.Theme.Text,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, -40, 1, 0),
        Parent = row,
    })

    local swatch = create("TextButton", {
        Text = "",
        BackgroundColor3 = default or Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(26, 18),
        Position = UDim2.new(1, -26, 0.5, -9),
        AutoButtonColor = false,
        Parent = row,
    })
    corner(swatch, 5)

    local current = default or Color3.fromRGB(255, 255, 255)
    local picker = create("Frame", {
        Name = "Picker",
        Size = UDim2.fromOffset(160, 90),
        Position = UDim2.new(1, -170, 0, 30),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 60,
        Parent = row,
    })
    corner(picker, 6)
    stroke(picker, self.Theme.Stroke, 1, 0.2)
    pad(picker, 8, 8, 8, 8)

    local hueBar = create("Frame", {
        Size = UDim2.new(1, 0, 0, 12),
        BackgroundColor3 = Color3.fromRGB(255, 0, 0),
        BorderSizePixel = 0,
        Parent = picker,
    })
    corner(hueBar, 3)
    local hueFill = create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = hueBar,
    })

    local svBar = create("Frame", {
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.fromOffset(0, 18),
        BackgroundColor3 = current,
        BorderSizePixel = 0,
        Parent = picker,
    })
    corner(svBar, 3)

    local hue = 0.75
    local sat = 1
    local val = 1
    local function updateColor(fire)
        current = Color3.fromHSV(hue, sat, val)
        swatch.BackgroundColor3 = current
        svBar.BackgroundColor3 = current
        hueFill.Size = UDim2.new(hue, 0, 1, 0)
        if fire and callback then
            local ok, err = pcall(callback, current)
            if not ok then
                self:Notify("خطأ", tostring(err), NotificationType.Error, 4)
            end
        end
        self._config[text] = { current.R, current.G, current.B }
    end

    local hDrag = false
    hueBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            hDrag = true
        end
    end)
    local hEnd = UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            hDrag = false
        end
    end)
    local hMove = UserInputService.InputChanged:Connect(function(i)
        if hDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local rel = (i.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X
            hue = math.clamp(rel, 0, 1)
            updateColor(true)
        end
    end)
    table.insert(self.Connections, hEnd)
    table.insert(self.Connections, hMove)

    local svDrag = false
    svBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            svDrag = true
        end
    end)
    local svEnd = UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            svDrag = false
        end
    end)
    local svMove = UserInputService.InputChanged:Connect(function(i)
        if svDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local relX = (i.Position.X - svBar.AbsolutePosition.X) / svBar.AbsoluteSize.X
            local relY = (i.Position.Y - svBar.AbsolutePosition.Y) / svBar.AbsoluteSize.Y
            sat = math.clamp(relX, 0, 1)
            val = math.clamp(1 - relY, 0, 1)
            updateColor(true)
        end
    end)
    table.insert(self.Connections, svEnd)
    table.insert(self.Connections, svMove)

    swatch.MouseButton1Click:Connect(function()
        picker.Visible = not picker.Visible
    end)

    updateColor(false)

    self.Widgets[text] = {
        Type = "Color",
        Get = function() return current end,
        Set = function(c) current = c; updateColor(true) end,
    }

    return {
        Set = function(_, c) current = c; updateColor(true) end,
        Get = function() return current end,
    }
end

function NyxUI:AddKeybind(parent, text, defaultKey, callback)
    local row = create("Frame", {
        Name = "KeybindRow",
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        Parent = parent,
    })

    create("TextLabel", {
        Text = text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = self.Theme.Text,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Size = UDim2.new(1, -80, 1, 0),
        Parent = row,
    })

    local keyBtn = create("TextButton", {
        Text = defaultKey and defaultKey.Name or "None",
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = self.Theme.Text,
        BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(70, 22),
        Position = UDim2.new(1, -70, 0.5, -11),
        AutoButtonColor = false,
        Parent = row,
    })
    corner(keyBtn, 5)

    local currentKey = defaultKey
    local listening = false

    keyBtn.MouseButton1Click:Connect(function()
        listening = true
        keyBtn.Text = "..."
    end)

    local conn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                keyBtn.Text = input.KeyCode.Name
                listening = false
            end
            return
        end
        if currentKey and input.KeyCode == currentKey then
            if callback then
                local ok, err = pcall(callback)
                if not ok then
                    self:Notify("خطأ", tostring(err), NotificationType.Error, 4)
                end
            end
        end
    end)
    table.insert(self.Connections, conn)

    self.Widgets[text] = {
        Type = "Keybind",
        Get = function() return currentKey end,
    }

    return {
        Set = function(_, k)
            currentKey = k
            keyBtn.Text = k and k.Name or "None"
        end,
        Get = function() return currentKey end,
    }
end

function NyxUI:_reflowNotifications()
    local baseY = 16
    local spacing = 8
    local index = 0
    for i = #self._notifications, 1, -1 do
        local notif = self._notifications[i]
        if notif.Frame and notif.Frame.Parent then
            local targetY = baseY + index * (notif.Height + spacing)
            quickTween(notif.Frame, {
                Position = UDim2.new(1, -280, 0, targetY),
            }, 0.14)
            index = index + 1
        end
    end
end

function NyxUI:Notify(title, message, notifType, duration)
    notifType = notifType or NotificationType.Info
    duration = duration or 3

    local color = self.Theme.Info
    if notifType == NotificationType.Success then color = self.Theme.Success
    elseif notifType == NotificationType.Error then color = self.Theme.Error
    elseif notifType == NotificationType.Warning then color = self.Theme.Warning
    elseif notifType == NotificationType.Info then color = self.Theme.Info
    end

    local notif = create("Frame", {
        Name = "Notification",
        Size = UDim2.fromOffset(260, 0),
        Position = UDim2.new(1, 20, 0, 16),
        BackgroundColor3 = self.Theme.Surface,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = self.Gui,
        ZIndex = 100,
    })
    corner(notif, 8)
    stroke(notif, color, 1, 0.3)
    pad(notif, 10, 10, 12, 12)
    list(notif, Enum.FillDirection.Vertical, 4)

    local header = create("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Parent = notif,
    })

    local dot = create("Frame", {
        Name = "Dot",
        Size = UDim2.fromOffset(8, 8),
        Position = UDim2.new(0, 0, 0.5, -4),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Parent = header,
    })
    corner(dot, 4)

    create("TextLabel", {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = self.Theme.Text,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -14, 1, 0),
        Parent = header,
    })

    create("TextLabel", {
        Text = message,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = self.Theme.TextDim,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = notif,
    })

    local rights = create("TextLabel", {
        Text = "حقوق " .. RIGHTS,
        Font = Enum.Font.Gotham,
        TextSize = 9,
        TextColor3 = self.Theme.TextDim,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Right,
        Size = UDim2.new(1, 0, 0, 10),
        Parent = notif,
    })

    local progressBg = create("Frame", {
        Name = "ProgressBg",
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        Parent = notif,
    })
    corner(progressBg, 2)

    local progressFill = create("Frame", {
        Name = "ProgressFill",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Parent = progressBg,
    })
    corner(progressFill, 2)

    notif.Size = UDim2.fromOffset(260, 0)
    local absHeight = notif.AbsoluteSize.Y
    if absHeight <= 0 then
        absHeight = 80
    end

    local entry = {
        Frame = notif,
        Height = absHeight,
        Color = color,
        Id = self._notificationOrder + 1,
    }
    self._notificationOrder = self._notificationOrder + 1
    table.insert(self._notifications, entry)

    self:_reflowNotifications()

    quickTween(progressFill, { Size = UDim2.new(0, 0, 1, 0) }, duration)

    task.delay(duration, function()
        if notif and notif.Parent then
            quickTween(notif, { Position = UDim2.new(1, 20, 0, notif.Position.Y.Offset) }, 0.12)
            task.delay(0.14, function()
                if notif and notif.Parent then
                    notif:Destroy()
                end
                for i = #self._notifications, 1, -1 do
                    if self._notifications[i].Frame == notif then
                        table.remove(self._notifications, i)
                    end
                end
                self:_reflowNotifications()
            end)
        end
    end)
end

function NyxUI:NotifySuccess(title, message, duration)
    self:Notify(title, message, NotificationType.Success, duration)
end

function NyxUI:NotifyError(title, message, duration)
    self:Notify(title, message, NotificationType.Error, duration)
end

function NyxUI:NotifyWarning(title, message, duration)
    self:Notify(title, message, NotificationType.Warning, duration)
end

function NyxUI:NotifyInfo(title, message, duration)
    self:Notify(title, message, NotificationType.Info, duration)
end

function NyxUI:SetTheme(themeName)
    if not Themes[themeName] then return end
    self.ThemeName = themeName
    self.Theme = Themes[themeName]
    self:_applyTheme()
end

function NyxUI:_saveConfig()
    if not writefile or not isfolder then return end
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(self._config or {})
    end)
    if not ok then return end
    if not isfolder("NyxUI") then
        pcall(makefolder, "NyxUI")
    end
    pcall(writefile, "NyxUI/" .. self.SaveName .. ".json", encoded)
end

function NyxUI:_loadConfig()
    if not readfile or not isfile then return end
    local path = "NyxUI/" .. self.SaveName .. ".json"
    if isfile(path) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(path))
        end)
        if ok and type(data) == "table" then
            self._config = data
        end
    end
end

function NyxUI:Save()
    self:_saveConfig()
    self:NotifySuccess("NyxUI", "تم حفظ الإعدادات", 2)
end

function NyxUI:Load()
    self:_loadConfig()
    for name, widget in pairs(self.Widgets) do
        local stored = self._config[name]
        if stored ~= nil then
            if widget.Type == "Toggle" and type(stored) == "boolean" then
                widget.Set(stored)
            elseif widget.Type == "Slider" and type(stored) == "number" then
                widget.Set(stored)
            elseif widget.Type == "Dropdown" then
                widget.Set(stored)
            elseif widget.Type == "Color" and type(stored) == "table" then
                widget.Set(Color3.new(stored[1], stored[2], stored[3]))
            end
        end
    end
    self:NotifySuccess("NyxUI", "تم تحميل الإعدادات", 2)
end

function NyxUI:Destroy()
    for _, conn in ipairs(self.Connections) do
        if conn and conn.Disconnect then
            pcall(function() conn:Disconnect() end)
        end
    end
    self.Connections = {}
    if self.Gui and self.Gui.Parent then
        self.Gui:Destroy()
    end
end

return NyxUI
