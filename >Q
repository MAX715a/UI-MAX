local function create(className, props)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

local function corner(inst, radius)
    create("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = inst })
end

local function stroke(inst, color, thickness, transparency)
    return create("UIStroke", {
        Color = color or Color3.fromRGB(55, 55, 75),
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = inst,
    })
end

local function pad(inst, t, b, l, r)
    create("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or 0),
        Parent = inst,
    })
end

local function list(inst, dir, spacing)
    create("UIListLayout", {
        FillDirection = dir or Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, spacing or 6),
        Parent = inst,
    })
end

local function quickTween(inst, props, duration)
    if not inst or not inst.Parent then return end
    local info = TweenInfo.new(duration or 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(inst, info, props):Play()
end

local NotificationType = {
    Success = "Success",
    Error = "Error",
    Warning = "Warning",
    Info = "Info",
}

local NyxUI = {}
NyxUI.__index = NyxUI

function NyxUI.new(opts)
    opts = opts or {}
    local self = setmetatable({}, NyxUI)

    self.ThemeName = opts.Theme or "Midnight"
    self.Theme = Themes[self.ThemeName] or Themes.Midnight
    self.Title = opts.Title or "NyxUI Lite"
    self.Subtitle = opts.Subtitle or (VERSION .. " — " .. RIGHTS)
    self.Width = opts.Width or 520
    self.Height = opts.Height or 400
    self.SaveName = opts.SaveName or "NyxUI_Config"
    self.Tabs = {}
    self.ActiveTab = nil
    self.Connections = {}
    self.Widgets = {}
    self._config = {}
    self._notifications = {}
    self._notificationOrder = 0

    self:_loadConfig()
    self:_buildGui()
    self:_buildWindow()
    self:_buildTabsBar()
    self:_buildContainer()
    self:_applyTheme()

    _G.NyxUI = self
    _G.NyxUI_RIGHTS = RIGHTS
    _G.NyxUI_VERSION = VERSION

    return self
end

function NyxUI:_buildGui()
    if self.Gui and self.Gui.Parent then
        self.Gui:Destroy()
    end
    local parent = (gethui and gethui()) or CoreGui or LocalPlayer:WaitForChild("PlayerGui")
    self.Gui = create("ScreenGui", {
        Name = "NyxUILite_MAX",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
        Parent = parent,
    })
end

function NyxUI:_buildWindow()
    local win = create("Frame", {
        Name = "Window",
        Size = UDim2.fromOffset(self.Width, self.Height),
        Position = UDim2.new(0.5, -self.Width / 2, 0.5, -self.Height / 2),
        BackgroundColor3 = self.Theme.Background,
        BorderSizePixel = 0,
        Parent = self.Gui,
    })
    corner(win, 10)
    stroke(win, self.Theme.Stroke, 1, 0.2)
    self.Window = win

    local titleBar = create("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1,
        Parent = win,
    })
    self.TitleBar = titleBar

    local titleLbl = create("TextLabel", {
        Name = "Title",
        Text = self.Title,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextColor3 = self.Theme.Text,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -80, 1, 0),
        Parent = titleBar,
    })
    self.TitleLabel = titleLbl

    local subLbl = create("TextLabel", {
        Name = "Subtitle",
        Text = self.Subtitle,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = self.Theme.TextDim,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.fromOffset(14, 20),
        Size = UDim2.new(1, -80, 0, 14),
        Parent = titleBar,
    })
    self.SubtitleLabel = subLbl

    local closeBtn = create("TextButton", {
        Name = "Close",
        Text = "✕",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = self.Theme.TextDim,
        BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -36, 0, 10),
        Size = UDim2.fromOffset(26, 26),
        AutoButtonColor = false,
        Parent = titleBar,
    })
    corner(closeBtn, 6)
    self.CloseButton = closeBtn

    closeBtn.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    local minBtn = create("TextButton", {
        Name = "Minimize",
        Text = "–",
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = self.Theme.TextDim,
        BackgroundColor3 = self.Theme.SurfaceAlt,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -68, 0, 10),
        Size = UDim2.fromOffset(26, 26),
        AutoButtonColor = false,
        Parent = titleBar,
    })
    corner(minBtn, 6)
    self.MinButton = minBtn

    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        local targetSize = minimized
            and UDim2.fromOffset(self.Width, 40)
            or UDim2.fromOffset(self.Width, self.Height)
        quickTween(win, { Size = targetSize }, 0.16)
        self.TabsBar.Visible = not minimized
        self.Container.Visible = not minimized
        self.Footer.Visible = not minimized
    end)

    local dragging, dragStart, startPos
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = win.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    local dragConn = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            win.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    table.insert(self.Connections, dragConn)

    local footer = create("TextLabel", {
        Name = "Footer",
        Text = "حقوق " .. RIGHTS .. " © " .. AUTHOR .. " — " .. VERSION,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextColor3 = self.Theme.TextDim,
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.new(1, -20, 0, 16),
        Position = UDim2.new(0, 10, 1, -20),
        Parent = win,
    })
    self.Footer = footer
end

